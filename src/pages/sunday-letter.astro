---
import Base from '../layouts/Base.astro';
---
<Base title="Sunday Letter: Write to Anna | Sundays with Anna" description="Write me a letter: ask about a product, suggest a review or just say hi. Or join the Sunday letter to get one honest recommendation every Sunday.">

<section class="p sl-wrap">
  <div class="sl-intro">
    <div class="hand sl-hand">write to me</div>
    <h1 class="hd sl-h1">Sunday letter</h1>
    <p class="sl-lead">Want me to try a product, review something from my shop, or answer a skincare question? Put it in a letter. I read every one, and your ideas decide which reviews I write next.</p>
  </div>

  <div class="sl-env" id="write">
    <div class="sl-back" aria-hidden="true"></div>
    <div class="sl-flap" aria-hidden="true"></div>

    <div class="sl-slot" id="sl-slot"><form class="sl-paper" id="sl-form" novalidate>
      <input type="hidden" name="access_key" value="b61efc79-331a-42df-99c5-34c84a99b073">
      <input type="hidden" name="subject" value="New letter from sundayswithanna.com">
      <input type="hidden" name="from_name" value="Sunday Letter">
      <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" style="display:none">
      <div class="sl-to hand">dear anna,</div>
      <fieldset class="sl-topics">
        <legend class="sl-legend">What is this about?</legend>
        <label><input type="radio" name="topic" value="product" checked><span>Ask about a product</span></label>
        <label><input type="radio" name="topic" value="review"><span>Suggest a review</span></label>
        <label><input type="radio" name="topic" value="hi"><span>Just say hi</span></label>
      </fieldset>
      <div class="sl-row">
        <label class="sl-f"><span>Your name</span><input type="text" name="name" autocomplete="name" required></label>
        <label class="sl-f"><span>Your email</span><input type="email" name="email" autocomplete="email" required></label>
      </div>
      <label class="sl-f"><span id="sl-msg-l">Which product are you curious about?</span><textarea name="message" rows="5" required></textarea></label>
      <div class="sl-send">
        <button type="submit" class="sl-btn">Send my letter</button>
        <span class="sl-status" id="sl-status" role="status"></span>
      </div>
    </form></div>

    <div class="sl-lid" aria-hidden="true"></div>
    <div class="sl-front" aria-hidden="true"></div>
    <div class="sl-stamp hand" aria-hidden="true">with love ♡</div>
  </div>
  <div class="sl-done" id="sl-done" hidden><div class="hand sl-done-h" id="sl-done-h"></div><p id="sl-done-p"></p><button type="button" class="sl-again" id="sl-again">Write another letter</button></div>
</section>

<section class="p sl-sub-wrap">
  <div class="sl-sub">
    <div>
      <div class="hand sl-hand2">every sunday</div>
      <h2 class="hd sl-h2">Get the Sunday letter</h2>
      <p class="sl-subp">One honest recommendation in your inbox every Sunday, with tips and tested picks from me.</p>
    </div>
    <form class="sl-subform" id="sl-sub" novalidate>
      <input type="email" name="email" placeholder="Your email" aria-label="Your email" required>
      <button type="submit" class="sl-btn sl-btn2">Join</button>
      <div class="sl-status" id="sl-sub-status" role="status"></div>
    </form>
  </div>
</section>
</Base>

<script>
  // Letters go to hello@sundayswithanna.com through Web3Forms. The subscribe form is not connected yet (MailerLite later).
  const LETTER_ENDPOINT = 'https://api.web3forms.com/submit';
  const SUB_ENDPOINT = '';
  const hints = {
    product: 'Which product are you curious about?',
    review: 'Which product should I review next?',
    hi: 'What would you like to tell me?'
  };
  const form = document.getElementById('sl-form');
  const lab = document.getElementById('sl-msg-l');
  form.querySelectorAll('input[name=topic]').forEach(r => r.addEventListener('change', () => { lab.textContent = hints[r.value]; }));
  function wire(f, status, endpoint, okText, onDone) {
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!f.checkValidity()) { status.textContent = 'Please fill in the highlighted fields.'; f.reportValidity(); return; }
      if (!endpoint) { status.textContent = 'Preview only: sending is not connected yet.'; if (onDone) onDone(false); return; }
      status.textContent = 'Sending...';
      try {
        const r = await fetch(endpoint, { method: 'POST', headers: { 'Accept': 'application/json' }, body: new FormData(f) });
        const j = await r.json(); if (!r.ok || !j.success) throw new Error('x');
        f.reset(); status.textContent = okText; if (onDone) onDone(true);
      } catch (_) { status.textContent = 'Something went wrong. Please try again in a moment.'; }
    });
  }
  const env = document.getElementById('write'), slot = document.getElementById('sl-slot'), paper = form;
  const done = document.getElementById('sl-done'), doneH = document.getElementById('sl-done-h'), doneP = document.getElementById('sl-done-p');
  const stamp = env.querySelector('.sl-stamp');
  function closeEnvelope(ok) {
    slot.style.height = slot.offsetHeight + 'px';
    env.style.setProperty('--d', (paper.offsetHeight - 70) + 'px');
    void slot.offsetHeight;
    env.classList.add('sl-sent');
    stamp.textContent = ok ? 'sent with love \u2661' : 'preview only';
    doneH.textContent = ok ? 'thank you!' : 'preview only';
    doneP.textContent = ok ? 'Your letter is on its way to me. I read every one.' : 'Nothing was sent: the form is not connected yet. This is how it will look.';
    setTimeout(() => { done.hidden = false; }, 1400);
  }
  document.getElementById('sl-again').addEventListener('click', () => {
    env.classList.remove('sl-sent'); slot.style.height = ''; done.hidden = true; stamp.textContent = 'with love \u2661';
  });
  wire(form, document.getElementById('sl-status'), LETTER_ENDPOINT, 'Thank you! Your letter is on its way to me.', closeEnvelope);
  wire(document.getElementById('sl-sub'), document.getElementById('sl-sub-status'), SUB_ENDPOINT, 'You are in! See you on Sunday.');
</script>

<style is:global>
.s .sl-wrap{padding-top:44px;padding-bottom:20px;max-width:1100px;margin:0 auto}
.s .sl-intro{text-align:center;max-width:680px;margin:0 auto 34px}
.s .sl-hand{font-size:46px;transform:rotate(-2deg);display:inline-block}
.s .sl-h1{margin:4px 0 14px;font-size:96px;line-height:.92}
.s .sl-lead{margin:0 auto;font-size:19px;line-height:1.55;color:#333}

/* envelope */
.s .sl-env{position:relative;max-width:760px;min-height:290px;margin:70px auto 0;padding:0 28px;filter:drop-shadow(0 18px 28px rgba(106,43,61,.14))}
.s .sl-back{position:absolute;left:0;right:0;bottom:0;height:290px;background:#E7A9BC;border-radius:6px 6px 14px 14px;z-index:0}
.s .sl-flap{position:absolute;left:0;right:0;bottom:290px;height:120px;background:#D98DA5;clip-path:polygon(0 100%,50% 0,100% 100%);z-index:0}
.s .sl-slot{overflow:hidden;margin:0 -24px;padding:24px 24px 0;position:relative;z-index:1}
.s .sl-lid{position:absolute;left:0;right:0;bottom:88px;height:202px;background:#DE9CB1;clip-path:polygon(0 0,100% 0,50% 100%);z-index:2;transform:scaleY(0);transform-origin:top;pointer-events:none}
.s .sl-done{max-width:560px;margin:34px auto 0;text-align:center}
.s .sl-done-h{font-size:46px;transform:rotate(-1.5deg);display:inline-block}
.s .sl-done p{margin:8px 0 14px;font-size:18px;line-height:1.5;color:#333}
.s .sl-again{border:0;background:transparent;font:600 13px 'Inter Tight',sans-serif;letter-spacing:.06em;text-transform:uppercase;color:#8F2E47;text-decoration:underline;text-underline-offset:4px;cursor:pointer}
.s .sl-sent .sl-paper{transform:translateY(var(--d))!important;transition:transform .9s cubic-bezier(.5,0,.3,1)}
.s .sl-sent .sl-slot{height:0!important;padding:0;transition:height .5s ease .9s,padding .5s ease .9s}
.s .sl-sent .sl-flap{opacity:0;transition:opacity .25s ease .9s}
.s .sl-sent .sl-lid{transform:scaleY(1);transition:transform .55s ease 1s}
.s .sl-paper{position:relative;z-index:1;background:#FFFEFC;border-radius:6px;padding:34px 40px 260px;margin-top:0;box-shadow:0 1px 0 rgba(0,0,0,.04);transition:transform .35s cubic-bezier(.2,.8,.2,1)}
.s .sl-env:has(.sl-btn:hover) .sl-paper,.s .sl-env:has(.sl-btn:focus-visible) .sl-paper{transform:translateY(-14px)}
.s .sl-env:has(.sl-btn:active) .sl-paper{transform:translateY(-8px)}
.s .sl-front{position:absolute;left:0;right:0;bottom:0;height:210px;background:#F2C6D3;clip-path:polygon(0 0,50% 58%,100% 0,100% 100%,0 100%);border-radius:0 0 14px 14px;z-index:2;pointer-events:none}
.s .sl-stamp{position:absolute;z-index:3;left:50%;bottom:26px;transform:translateX(-50%) rotate(-3deg);font-size:34px;color:#8F2E47;pointer-events:none}

.s .sl-to{font-size:44px;transform:rotate(-1.5deg);display:inline-block;margin-bottom:10px}
.s .sl-topics{border:0;padding:0;margin:0 0 20px;display:flex;flex-wrap:wrap;gap:10px}
.s .sl-legend{padding:0;margin:0 0 10px;width:100%;font:600 12px 'Inter Tight',sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#8A8A8A}
.s .sl-topics label{cursor:pointer}
.s .sl-topics input{position:absolute;opacity:0;pointer-events:none}
.s .sl-topics span{display:inline-block;padding:9px 18px;border:2px solid #6A2B3D;border-radius:999px;font:500 14px 'Inter Tight',sans-serif;color:#6A2B3D;transition:background .15s,color .15s}
.s .sl-topics label:hover span{background:#F7E3EA}
.s .sl-topics input:checked + span{background:#6A2B3D;color:#fff}
.s .sl-topics input:focus-visible + span{outline:2px solid #B0475E;outline-offset:3px}
.s .sl-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px}
.s .sl-f{display:block;margin-bottom:18px}
.s .sl-f span{display:block;margin-bottom:6px;font:600 12px 'Inter Tight',sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#8A8A8A}
.s .sl-f input,.s .sl-f textarea{width:100%;box-sizing:border-box;border:0;border-bottom:1.5px solid #B8B8B8;background:transparent;padding:8px 0;font:19px/1.5 'Newsreader',serif;color:#222;outline:0;resize:vertical;border-radius:0}
.s .sl-f textarea{background:linear-gradient(transparent 29px,#EEDDE3 29px,#EEDDE3 30px,transparent 30px);background-size:100% 30px;line-height:30px;padding-top:0;min-height:150px}
.s .sl-f input:focus,.s .sl-f textarea:focus{border-bottom-color:#B0475E}
.s .sl-f input:invalid:not(:placeholder-shown){border-bottom-color:#B0475E}
.s .sl-send{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.s .sl-btn{border:0;background:#8F2E47;color:#fff;padding:18px 40px;font-size:15px;box-shadow:0 8px 18px rgba(143,46,71,.28);border-radius:999px;font:600 14px 'Inter Tight',sans-serif;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;transition:background .15s,transform .15s,box-shadow .15s}
.s .sl-btn:hover{background:#6A2B3D;transform:translateY(-2px);box-shadow:0 12px 22px rgba(106,43,61,.32)}
.s .sl-btn:focus-visible{outline:2px solid #6A2B3D;outline-offset:3px}
.s .sl-status{font:500 14px 'Inter Tight',sans-serif;color:#6A2B3D;min-height:1.2em}

/* subscribe band */
.s .sl-sub-wrap{max-width:1100px;margin:90px auto 0}
.s .sl-sub{background:#F7F7F7;border-radius:28px;padding:44px;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:36px;align-items:center}
.s .sl-hand2{font-size:40px;transform:rotate(-1.5deg);display:inline-block}
.s .sl-h2{margin:6px 0 10px;font-size:44px}
.s .sl-subp{margin:0;font-size:18px;line-height:1.55;color:#333;max-width:420px}
.s .sl-subform{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.s .sl-subform input{flex:1 1 200px;min-width:0;height:52px;padding:0 22px;border:0;border-radius:999px;background:#fff;font:500 16px 'Inter Tight',sans-serif;color:#111;outline:0}
.s .sl-subform input:focus{outline:2px solid #B0475E;outline-offset:2px}
.s .sl-btn2{height:52px;padding:0 28px;background:#F2C6D3;color:#8F2E47}
.s .sl-btn2:hover{background:#EBB1C3;color:#8F2E47}
.s .sl-subform .sl-status{flex:1 1 100%}

@media (max-width:760px){
  .s .sl-h1{font-size:54px}.s .sl-hand{font-size:38px}
  .s .sl-env{padding:0 10px;margin-top:56px}
  .s .sl-paper{padding:26px 20px 230px}
  .s .sl-row{grid-template-columns:1fr;gap:0}
  .s .sl-env{min-height:250px}
  .s .sl-back{height:250px}.s .sl-flap{bottom:250px;height:90px}.s .sl-front{height:170px}.s .sl-lid{bottom:71px;height:179px}
  .s .sl-stamp{font-size:28px;bottom:18px}
  .s .sl-sub{grid-template-columns:1fr;padding:30px 22px}.s .sl-h2{font-size:34px}
}
</style>
