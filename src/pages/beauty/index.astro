---
import Base from '../../layouts/Base.astro';
import SundayReset from '../../components/SundayReset.astro';
---
<Base title="Beauty | Sundays with Anna">

<section class="p" style="padding-top:56px;display:flex;justify-content:space-between;align-items:end;gap:30px;flex-wrap:wrap"><h1 class="hd" style="margin:0;font-size:150px">Beauty</h1><p style="margin:0 0 14px;max-width:340px;font-size:15px;color:#5C5C5C">Every product reviewed here is one I have used myself. Filter by what your skin feels today.</p></section>
<SundayReset />
<section class="p" style="padding-top:28px;display:flex;gap:8px;flex-wrap:wrap"><a class="pill on" href="#" data-f="all">All</a><a class="pill" href="#" data-f="dry">Dry and tight</a><a class="pill" href="#" data-f="pores">Visible pores</a><a class="pill" href="#" data-f="sun">Sun protection</a><a class="pill" href="#" data-f="dark">Dark spots</a></section>
<section class="p" id="grid" style="padding-top:32px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px 20px">
<a data-t="pores" href="/beauty/medicube-zero-pore-pad-review/"><div class="img" style="height:520px"><img src="/img/sink.webp" alt="Medicube pads" style="object-position:50% 100%"></div><div class="up" style="margin-top:14px;font-size:14px">Medicube Zero Pore Pad 2.0, three years in</div><div style="color:#8A8A8A">Review · Visible pores</div></a>
<a data-t="sun" href="/beauty/round-lab-birch-juice-sunscreen-review/"><div class="img" style="height:520px"><img src="/img/round-lab-cover.webp" alt="Round Lab Birch Juice sun serum, Mild-Up and sunscreen" style="object-position:50% 50%"></div><div class="up" style="margin-top:14px;font-size:14px">Round Lab Birch Juice sunscreen: all four versions compared</div><div style="color:#8A8A8A">Review · Sun protection</div></a>
<a data-t="sun" href="/beauty/round-lab-camellia-deep-collagen-sun-serum-review/"><div class="ph" style="height:520px"><span>Photo coming soon</span></div><div class="up" style="margin-top:14px;font-size:14px">Round Lab Camellia Deep Collagen sun serum: SPF 50+ with collagen and retinoid</div><div style="color:#8A8A8A">Review · Sun protection</div></a>
<a data-t="sun" href="/beauty/beauty-of-joseon-relief-sun-review/"><div class="ph" style="height:520px"><span>Photo coming soon</span></div><div class="up" style="margin-top:14px;font-size:14px">Beauty of Joseon Relief Sun: Rice + Probiotics vs Aqua-Fresh</div><div style="color:#8A8A8A">Review · Sun protection</div></a>
<a data-t="dry" href="/beauty/biodance-bio-collagen-real-deep-mask-review/"><div class="ph" style="height:520px"><span>Photo coming soon</span></div><div class="up" style="margin-top:14px;font-size:14px">Biodance Bio-Collagen mask: pink, blue and purple compared</div><div style="color:#8A8A8A">Review · Dry and tight</div></a>
<a data-t="dark" href="/beauty/axis-y-dark-spot-correcting-glow-serum-review/"><div class="ph" style="height:520px"><span>Photo coming soon</span></div><div class="up" style="margin-top:14px;font-size:14px">Axis-Y Dark Spot Correcting Glow Serum: ingredients, results and how to use it</div><div style="color:#8A8A8A">Review · Dark spots</div></a>
<a data-t="dry" href="/beauty/morning-skincare-routine-dry-skin-winter/"><div class="img" style="height:520px"><img src="/img/bshelf.webp" alt="Shelf"></div><div class="up" style="margin-top:14px;font-size:14px">My morning routine for dry skin in winter</div><div style="color:#8A8A8A">Routine · Dry and tight</div></a>
</section>


<script is:inline>
document.querySelectorAll('.pill[data-f]').forEach(function(b){b.addEventListener('click',function(e){e.preventDefault();document.querySelectorAll('.pill[data-f]').forEach(function(x){x.classList.remove('on')});b.classList.add('on');var f=b.dataset.f;document.querySelectorAll('#grid>a').forEach(function(c){c.style.display=(f==='all'||c.dataset.t===f)?'':'none'})})});
</script>
</Base>
