---
import Base from '../../layouts/Base.astro';
import ArticleCards from '../../components/ArticleCards.astro';
import HabitOfWeek from '../../components/HabitOfWeek.astro';
const cards = [
  '/notes/gut-health-and-skin-barrier/',
  '/notes/foods-and-supplements-for-skin/',
  '/notes/foods-that-cause-breakouts/',
  '/notes/gut-health-checklist/',
  '/notes/best-foods-for-skin/',
  '/notes/recipes/green-glow-smoothie/',
];
---
<Base title="Notes | Sundays with Anna" description="Advice, guides and small habits for healthy, glowing skin, without product reviews.">
<section class="p" style="padding-top:56px;display:flex;justify-content:space-between;align-items:end;gap:30px;flex-wrap:wrap"><div><h1 class="hd" style="margin:0;font-size:150px">Notes</h1><div class="hand" style="font-size:36px;transform:rotate(-2deg);margin-top:4px">things I wish I knew sooner</div></div><p style="margin:0 0 14px;max-width:340px;font-size:15px;color:#5C5C5C">Advice, guides and small habits for healthy skin. No product reviews here, just what I have learned.</p></section>
<HabitOfWeek />
<section class="p" style="padding-top:28px;padding-bottom:28px;display:flex;gap:8px;flex-wrap:wrap"><a class="pill on" href="#" data-f="all">All</a><a class="pill" href="#" data-f="Skin concerns">Skin concerns</a><a class="pill" href="#" data-f="Glow foods">Glow foods</a><a class="pill" href="#" data-f="Habits">Habits</a><a class="pill" href="#" data-f="Recipes">Recipes</a><a class="up arrow" href="/notes/recipes/" style="margin-left:auto;align-self:center;color:#B0475E">All recipes</a></section>
<ArticleCards items={cards} compact />
<script is:inline>
document.querySelectorAll('.pill[data-f]').forEach(function(b){b.addEventListener('click',function(e){e.preventDefault();document.querySelectorAll('.pill[data-f]').forEach(function(x){x.classList.remove('on')});b.classList.add('on');var f=b.dataset.f;document.querySelectorAll('#grid>a').forEach(function(c){c.style.display=(f==='all'||c.dataset.t===f)?'':'none'})})});
</script>
</Base>
