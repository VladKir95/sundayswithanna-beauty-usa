---
import Base from '../layouts/Base.astro';
import { categories, brandOf, tagsOf, slugOf } from '../data/shop.mjs';
const money = (n) => '$' + n.toFixed(2);
let n = 0;
const cats = categories.map(c => {
  const count = c.groups.reduce((s,g) => s + g.items.length, 0);
  const groups = c.groups.map(g => ({ ...g, items: g.items.map(it => {
    n++;
    const singles = it.rows.filter(r => r.p != null && !r.set).map(r => r.p);
    return { ...it, slug: slugOf(it.name), brand: brandOf(it.name), tags: tagsOf(it, g.title).join(' '), n: String(n).padStart(2,'0'), low: singles.length ? Math.min(...singles) : null };
  })}));
  return { ...c, count, groups };
});
const TAGS = [['sun','Sun'],['hydration','Hydration'],['pores','Pores & blemishes'],['glow','Brightening'],['soothing','Soothing'],['firming','Firming'],['lips','Lips'],['hair','Hair'],['body','Body']];
const brands = [...new Set(cats.flatMap(c => c.groups.flatMap(g => g.items.map(i => i.brand))).filter(Boolean))].sort((a,b)=>a.localeCompare(b));
const listItems = cats.flatMap(c => c.groups.flatMap(g => g.items)).map((it, i) => ({
  '@type': 'ListItem', position: i + 1,
  item: { '@type': 'Product', name: it.name, url: '/shop/#' + it.slug, ...(it.brand ? { brand: { '@type': 'Brand', name: it.brand } } : {}), ...(it.img ? { image: it.img } : {}) }
}));
const itemListLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'ItemList', name: 'Shop my picks: skincare, hair and body favorites', numberOfItems: listItems.length, itemListElement: listItems });
---
<Base title="Shop My Picks: K-Beauty and Skincare Favorites | Sundays with Anna" description="Every product here is one I own and use: K-beauty skincare, sunscreens, masks, hair and body care, with current prices at YesStyle, Sephora, Ulta and Amazon.">
<script type="application/ld+json" set:html={itemListLd}></script>
<section class="p shp-top"><div class="shp-hero">
<div>
<div class="up" style="color:#8A8A8A">Shop</div>
<h1 class="hd" style="margin:10px 0 0;font-size:96px;line-height:.95">Shop my picks</h1>
<div class="hand" style="font-size:36px;transform:rotate(-2deg);margin-top:12px">the things I actually use</div>
<p style="margin:22px 0 0;max-width:620px;font-size:18px;line-height:1.55">My favourite finds in one place, sorted by category, with the current price in each shop so you can pick the one that suits you. Tap a product name to read my full review.</p>
</div>
<nav class="shp-toc" aria-label="Shop categories"><div class="up" style="color:#8A8A8A;margin-bottom:10px">In the shop</div>
{cats.map(c => (<a href={'#' + c.id} class={c.count ? 'on' : 'off'}><span>{c.title}</span><i>{c.count ? c.count + ' picks' : 'soon'}</i></a>))}
</nav></div></section>
<section class="p shp-intro"><div class="ivB">
<div class="hand ivB-hand">not a random list, my real shelf</div>
<h2 class="hd ivB-h">Every product here is one I own and use</h2>
<div class="ivB-cols"><p>As a beauty blogger I try and use a lot of products, and this page is where my favourites live: K-beauty skincare, sunscreens, serums, creams, masks and patches, plus hair and body care. Nothing here is added just to fill a list.</p><p>I'm writing a full review for each product, one by one, starting with the most requested ones from you. For the rest, the review is on its way. Prices are shown for each shop, so you can pick the one that works best for you.</p></div>
<div class="ivB-facts"><span>My real shelf</span><span>Reviews one by one</span><span>Prices in every shop</span></div>
</div></section>
<section class="p shp-filt" id="shp-filt"><div class="shp-panel shp-fp">
<div class="shp-fhead"><h2 class="shp-ftitle">Find your pick</h2><div class="hand shp-note">by concern, brand or name</div></div>
<div class="shp-frow">
<label class="shp-search"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg><input type="search" id="shp-q" placeholder="Search products or brands" aria-label="Search products" autocomplete="off" /></label>
<div class="shp-sel"><select id="shp-brand" aria-label="Brand"><option value="">All brands</option>{brands.map(b => <option value={b}>{b}</option>)}</select></div>
</div>
<div class="shp-chips" role="group" aria-label="Filter by concern"><button type="button" data-tag="" class="on">All</button>{TAGS.map(([k,l]) => <button type="button" data-tag={k}>{l}</button>)}</div>
<div class="shp-count" id="shp-count" aria-live="polite"></div>
</div></section>
<section class="p gg-teaser"><div class="gg-band">
<div><div class="up gg-bk">New</div><h2 class="hd gg-bt">Curated gift guides</h2><div class="hand gg-bh">little things worth giving</div><p>Themed lists from my favourites: under $15, for the sunscreen lover, a self-care night in and more.</p></div>
<a class="gg-btn" href="/gift-guides/">Explore gift guides <span aria-hidden="true">→</span></a>
</div></section>
{cats.map(c => (<>
<div class="p shp-cathead" id={c.id}><h2 class="hd" style="margin:0;font-size:44px">{c.title}</h2></div>
{c.groups.map(g => (
<section class="p shp-sec"><div class="shp-panel">
<div class="shp-head"><div><h2 class="shp-title">{g.title}</h2><div class="hand shp-note">{g.note}</div></div><span class="shp-pill">{g.tag}</span></div>
{g.items.length === 0 ? (
<div class="shp-grid"><article class="shp-card shp-empty"><div class="shp-img ph"><span>Coming soon<br><em>My favourites for this category are on their way</em></span></div></article></div>
) : (<>
<div class="shp-grid" data-grid>
{g.items.map(it => (
<article class="shp-card" id={it.slug} data-brand={it.brand} data-tags={it.tags} data-name={(it.name + " " + it.sub).toLowerCase()}>
<div class="shp-top2"><span>{it.n}</span><span class="shp-ic" aria-hidden="true">≡</span></div>
{it.img ? <div class="shp-img"><img src={it.img} alt={it.name} loading="lazy" /></div> : <div class="shp-img ph"><span>Product photo<br><em>{it.name}</em></span></div>}
<div class="shp-info"><div>{it.review ? <a class="shp-name" href={it.review}>{it.name}</a> : <span class="shp-name">{it.name}</span>}<div class="shp-sub">{it.sub}</div></div><div class="shp-low">{it.low != null ? <><small>from</small>{money(it.low)}</> : <small>see shops</small>}</div></div>
{it.review ? <a class="shp-bdg on" href={it.review}>Read my review <span aria-hidden="true">→</span></a> : <span class="shp-bdg">Review coming soon</span>}
<div class="shp-rows">
{it.rows.map(r => (
<a class="shp-row" href={r.u} rel="noopener sponsored" target="_blank"><span>{r.shop}</span>{r.p != null ? <b>{money(r.p)}{r.set ? <em>{r.set}</em> : null}</b> : <i>{r.note || 'check price'}</i>}</a>
))}
</div>
</article>
))}
</div>
{g.items.length > 6 ? <button type="button" class="shp-more" data-more>Show more ({g.items.length - 6})</button> : null}
</>)}
</div></section>
))}
</>))}
<a href="#top" id="shp-up" class="shp-up" aria-label="Back to top">↑</a>
<script is:inline>
(function(){
var q=document.getElementById('shp-q'),br=document.getElementById('shp-brand'),chips=document.querySelectorAll('.shp-chips button'),cnt=document.getElementById('shp-count');
var tag='';
var secs=[].slice.call(document.querySelectorAll('.shp-sec'));
function setup(s){var g=s.querySelector('[data-grid]');if(!g)return;var cs=[].slice.call(g.children);s._cards=cs;s._open=false;s._btn=s.querySelector('[data-more]');
 if(s._btn)s._btn.addEventListener('click',function(){s._open=!s._open;apply();});}
secs.forEach(setup);
function apply(){
 var term=(q.value||'').trim().toLowerCase(),b=br.value,active=!!(term||b||tag),shown=0;
 secs.forEach(function(s){
  if(!s._cards){s.hidden=active;return;}
  var vis=0,limit=10;
  s._cards.forEach(function(c){
   var ok=(!term||c.dataset.name.indexOf(term)>-1||(c.dataset.brand||'').toLowerCase().indexOf(term)>-1)&&(!b||c.dataset.brand===b)&&(!tag||(' '+c.dataset.tags+' ').indexOf(' '+tag+' ')>-1);
   if(!ok){c.hidden=true;return;}
   vis++;c.hidden=!(active||s._open||vis<=limit);
  });
  shown+=vis;
  s.hidden=active&&vis===0;
  if(s._btn){s._btn.hidden=active||s._cards.length<=limit;s._btn.textContent=s._open?'Show less':'Show more ('+(s._cards.length-limit)+')';}
 });
 cnt.textContent=active?shown+' product'+(shown===1?'':'s')+' found':'';
 document.querySelectorAll('.shp-cathead').forEach(function(h){var n=h.nextElementSibling,any=false;while(n&&!n.classList.contains('shp-cathead')){if(n.classList.contains('shp-sec')&&!n.hidden)any=true;n=n.nextElementSibling;}h.hidden=active&&!any;});
}
function goHash(){var id=decodeURIComponent((location.hash||'').slice(1));if(!id||id==='top')return;var el=document.getElementById(id);if(!el||!el.classList.contains('shp-card'))return;var s=el.closest('.shp-sec');if(s&&s._cards){s._open=true;}apply();el.hidden=false;setTimeout(function(){el.scrollIntoView({behavior:'smooth',block:'center'});el.classList.add('shp-hit');setTimeout(function(){el.classList.remove('shp-hit');},3000);},120);}
q.addEventListener('input',apply);br.addEventListener('change',apply);
chips.forEach(function(c){c.addEventListener('click',function(){tag=c.dataset.tag;chips.forEach(function(x){x.classList.toggle('on',x===c);});apply();});});
try{var cn=new URLSearchParams(location.search).get('concern');if(cn){chips.forEach(function(x){if(x.dataset.tag===cn){tag=cn;chips.forEach(function(y){y.classList.toggle('on',y===x);});}});}}catch(e){}
apply();goHash();if(tag&&!location.hash.replace('#','')){var f=document.getElementById('shp-filt');if(f)setTimeout(function(){f.scrollIntoView({block:'start'});},50);}window.addEventListener('hashchange',goHash);
})();
</script>
<script is:inline>
(function(){
  var up=document.getElementById('shp-up');
  function onScroll(){ if(up) up.classList.toggle('show', window.scrollY>500); }
  window.addEventListener('scroll', onScroll, {passive:true}); onScroll();
  var links=document.querySelectorAll('.shp-bar a[data-cat]');
  var heads=[].slice.call(document.querySelectorAll('.shp-cathead'));
  function mark(){
    var cur=null, y=window.scrollY+120;
    heads.forEach(function(h){ if(h.offsetTop<=y) cur=h.id; });
    links.forEach(function(a){ a.classList.toggle('on', a.getAttribute('data-cat')===cur); });
  }
  window.addEventListener('scroll', mark, {passive:true}); mark();
  document.querySelectorAll('a[href="#top"]').forEach(function(a){
    a.addEventListener('click', function(e){ e.preventDefault(); window.scrollTo({top:0,behavior:'smooth'}); });
  });
})();
</script>
<style is:global>
html{scroll-behavior:smooth}
.s .shp-bar{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.96);backdrop-filter:blur(6px);border-bottom:1px solid #EAEAEA;margin-top:8px}
.s .shp-bar-in{display:flex;gap:8px;align-items:center;padding:12px 24px;overflow-x:auto;scrollbar-width:none}
.s .shp-bar-in::-webkit-scrollbar{display:none}
.s .shp-bar a{flex:none;padding:8px 16px;border:1.5px solid #111;border-radius:999px;font-family:'Inter Tight',sans-serif;font-weight:500;font-size:14px;color:#111;text-decoration:none;white-space:nowrap}
.s .shp-bar a:hover{background:#EDEDED}
.s .shp-bar a.on{background:#111;color:#fff}
.s .shp-bar .shp-bar-top{margin-left:auto;border-color:#C9C9C9;color:#6B6B6B}
.s .shp-up{position:fixed;right:max(20px,env(safe-area-inset-right,0px));bottom:max(20px,env(safe-area-inset-bottom,0px));z-index:50;width:48px;height:48px;border-radius:50%;background:#111;color:#fff;display:flex;align-items:center;justify-content:center;font-size:22px;text-decoration:none;opacity:0;pointer-events:none;transition:opacity .2s}
.s .shp-up.show{opacity:1;pointer-events:auto}
.s .shp-top{padding-top:56px;padding-bottom:20px}
.s .shp-hero{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:48px;align-items:start}
.s .shp-toc{background:#F7F7F7;border-radius:22px;padding:26px;display:flex;flex-direction:column}
.s .shp-toc a{display:flex;justify-content:space-between;align-items:baseline;padding:12px 0;border-bottom:1px solid #DADADA;font-family:'Inter Tight',sans-serif;font-weight:500;font-size:18px;color:#111;text-decoration:none}
.s .shp-toc a:last-child{border-bottom:0}
.s .shp-toc a i{font-style:normal;font-weight:400;font-size:13px;color:#8A8A8A}
.s .shp-toc a.off{color:#8A8A8A}
.s .shp-toc a:hover span{text-decoration:underline}
.s .shp-fine{max-width:760px;margin:16px 0 0;font-size:14px;line-height:1.55;color:#8A8A8A}
.s .shp-cathead{padding-top:44px;padding-bottom:0;scroll-margin-top:56px}
.s .shp-sec{padding-top:16px;padding-bottom:16px}
.s .shp-panel{background:#F7F7F7;border-radius:28px;padding:40px}
.s .shp-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:28px}
.s .shp-title{margin:0;font-family:'Inter Tight',sans-serif;font-weight:600;font-size:64px;line-height:.95;letter-spacing:-.03em;text-transform:none}
.s .shp-note{font-size:30px;transform:rotate(-2deg);margin-top:8px}
.s .shp-pill{flex:none;border:2px solid #111;border-radius:999px;padding:10px 22px;font-family:'Inter Tight',sans-serif;font-weight:500;font-size:16px}
.s .shp-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}
.s .shp-card{background:#EDEDED;border-radius:14px;padding:11px 11px 6px;display:flex;flex-direction:column;min-width:0}
.s .shp-empty{padding:22px}
.s .shp-empty .shp-img{margin:0}
.s .shp-top2{display:flex;justify-content:space-between;font-family:'Inter Tight',sans-serif;font-size:12px;color:#111}
.s .shp-ic{font-size:22px;line-height:1}
.s .shp-img{aspect-ratio:1/1;margin:8px 0 12px;border-radius:10px;background:#E0E0E0;overflow:hidden}
.s .shp-img img{display:block;width:100%;height:100%;object-fit:cover}
.s .shp-filt{padding-top:8px;padding-bottom:8px}
.s .shp-fp{display:flex;flex-direction:column;gap:22px}
.s .shp-fhead{display:flex;align-items:baseline;gap:22px;flex-wrap:wrap}
.s .shp-ftitle{margin:0;font-family:'Inter Tight',sans-serif;font-weight:600;font-size:44px;line-height:.95;letter-spacing:-.03em}
.s .shp-fhead .shp-note{margin:0}
.s .shp-frow{display:flex;gap:14px;flex-wrap:wrap}
.s .shp-search{flex:1 1 320px;min-width:0;display:flex;align-items:center;gap:12px;height:56px;padding:0 22px;background:#fff;border-radius:999px;color:#111}
.s .shp-search:focus-within,.s .shp-sel select:focus{outline:2px solid #B0475E;outline-offset:2px}
.s #shp-q{flex:1;min-width:0;height:100%;border:0;background:transparent;outline:0;font-family:'Inter Tight',sans-serif;font-weight:500;font-size:17px;color:#111}
.s #shp-q::placeholder{color:#8A8A8A}
.s .shp-sel{flex:0 1 240px;min-width:0;position:relative}
.s .shp-sel::after{content:"";position:absolute;right:24px;top:50%;width:8px;height:8px;border-right:2px solid #111;border-bottom:2px solid #111;transform:translateY(-70%) rotate(45deg);pointer-events:none}
.s #shp-brand{appearance:none;-webkit-appearance:none;width:100%;height:56px;padding:0 50px 0 24px;border:0;border-radius:999px;background:#fff;font-family:'Inter Tight',sans-serif;font-weight:500;font-size:17px;color:#111;cursor:pointer}
.s .shp-chips{display:flex;flex-wrap:wrap;gap:10px}
.s .shp-chips button{padding:10px 22px;border:2px solid #111;border-radius:999px;background:transparent;font-family:'Inter Tight',sans-serif;font-weight:500;font-size:16px;color:#111;cursor:pointer;transition:background .15s,color .15s}
.s .shp-chips button:hover{background:#fff}
.s .shp-chips button.on{background:#111;color:#fff}
.s .shp-count{font-family:'Inter Tight',sans-serif;font-weight:500;font-size:15px;color:#8A8A8A}
.s .shp-count:empty{display:none}
@media (max-width:640px){.s .shp-sel{flex:1 1 100%}.s .shp-ftitle{font-size:34px}.s .shp-fp{gap:18px}}
.s .shp-more{display:block;margin:24px auto 0;height:44px;padding:0 28px;border:1px solid #111;background:transparent;font:600 14px 'Inter Tight',sans-serif;text-transform:uppercase;letter-spacing:.06em;color:#111;cursor:pointer}
.s .shp-more:hover{background:#111;color:#fff}
.s [hidden]{display:none!important}
.s .shp-info{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.s .shp-name{font-family:'Inter Tight',sans-serif;font-weight:500;font-size:13.5px;line-height:1.25;color:#111;text-decoration:none}
.s a.shp-name:hover{text-decoration:underline}
.s .shp-bdg{align-self:flex-start;display:inline-block;margin-top:10px;padding:5px 11px;border-radius:999px;background:#fff;color:#7A7A7A;font-family:'Inter Tight',sans-serif;font-weight:600;font-size:11px;letter-spacing:.06em;text-transform:uppercase;text-decoration:none;line-height:1.2}
.s a.shp-bdg.on{background:#F2C6D3;color:#8F2E47;padding:7px 15px;font-size:12px;box-shadow:0 2px 8px rgba(176,71,94,.18);transition:background .15s,transform .15s}
.s a.shp-bdg.on:hover{background:#EBB1C3;transform:translateY(-1px)}
.s .ivB{background:#F7F7F7;border-radius:28px;padding:44px 44px 36px}
.s .ivB-hand{font-size:44px;line-height:1;transform:rotate(-1.5deg);display:inline-block}
.s .ivB-h{margin:8px 0 0;font-size:40px}
.s .ivB-cols{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:32px;margin-top:22px}
.s .ivB-cols p{margin:0;font-size:18px;line-height:1.6;color:#333}
.s .ivB-facts{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
.s .ivB-facts span{background:#F2C6D3;color:#8F2E47;border-radius:999px;padding:8px 16px;font:600 12px 'Inter Tight',sans-serif;letter-spacing:.06em;text-transform:uppercase}
@media(max-width:760px){.s .ivB{padding:28px 22px}.s .ivB-cols{grid-template-columns:minmax(0,1fr);gap:14px}.s .ivB-h{font-size:30px}.s .ivB-hand{font-size:38px}}
.s .shp-filt .shp-fp{background:#F2C6D3}
.s .shp-filt .shp-ftitle{color:#6A2B3D}
.s .shp-filt .shp-fhead .shp-note{color:#B0475E}
.s .shp-filt .shp-count{color:#8F2E47}
.s .shp-filt .shp-chips button{border-color:#6A2B3D;color:#4A2530}
.s .shp-filt .shp-chips button:hover{background:#fff}
.s .shp-filt .shp-chips button.on{background:#6A2B3D;border-color:#6A2B3D;color:#fff}
.s .gg-teaser .gg-band{background:#F7F7F7}
.s .gg-teaser .gg-btn{background:#F2C6D3;color:#8F2E47}
.s .gg-teaser .gg-btn:hover{background:#EBB1C3;color:#6A2B3D}
.s .shp-card{scroll-margin-top:90px}
.s .shp-card.shp-hit{outline:3px solid #C2517A;outline-offset:3px;transition:outline-color .3s}
.s .shp-sub{margin-top:3px;font-size:12px;color:#6B6B6B}
.s .shp-low{flex:none;text-align:right;font-family:'Inter Tight',sans-serif;font-weight:600;font-size:14px;color:#111}
.s .shp-low small{display:block;font-weight:400;font-size:11px;color:#8A8A8A;letter-spacing:.04em}
.s .shp-rows{margin-top:10px;border-top:1px solid #D4D4D4}
.s .shp-row{display:flex;justify-content:space-between;align-items:baseline;gap:6px;padding:5px 0;border-bottom:1px solid #D4D4D4;font-size:12px;color:#111;text-decoration:none}
.s .shp-row:last-child{border-bottom:0}
.s .shp-row:hover{background:#E4E4E4}
.s .shp-row b{font-family:'Inter Tight',sans-serif;font-weight:600;text-align:right}
.s .shp-row b em{display:block;font-style:normal;font-weight:400;font-size:11px;color:#8A8A8A}
.s .shp-row i{font-style:normal;color:#8A8A8A;font-size:13px}
@media (max-width:1100px){.s .shp-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media (max-width:900px){.s .shp-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:900px){.s .shp-title{font-size:48px}.s .shp-hero{grid-template-columns:1fr}}
@media (max-width:640px){.s .shp-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.s .shp-panel{padding:24px 18px}.s .shp-title{font-size:38px}.s .shp-head{flex-direction:column}.s .shp-top .hd{font-size:60px!important}}
</style>
</Base>
