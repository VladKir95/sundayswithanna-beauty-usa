---
import { articles } from '../data/articles.mjs';
const { items = [] } = Astro.props;
const isNotes = (items[0] || '').startsWith('/notes/');
const list = items.map((h) => ({ href: h, ...articles[h] })).filter((a) => a.title);
const svg = (p) => `<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;
const icons = {
  facts: ['Product facts', svg('<rect x="5" y="4" width="14" height="16" rx="2"/><path d="M9 9h6M9 13h6M9 17h3"/>')],
  ing: ['Ingredients', svg('<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-9V3"/><path d="M8 15h8"/>')],
  skin: ['Skin concerns', svg('<path d="M12 3c3 4 6 7 6 10.5A6 6 0 0 1 6 13.5C6 10 9 7 12 3z"/>')],
  sun: ['SPF', svg('<circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/>')],
  eye: ['Eye patches', svg('<path d="M2 12s4-6 10-6 10 6 10 6-4 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="2.5"/>')],
  face: ['Face products', svg('<circle cx="12" cy="12" r="9"/><path d="M8.5 14.5c1 1.2 2.2 1.8 3.5 1.8s2.5-.6 3.5-1.8M9 10h.01M15 10h.01"/>')],
  research: ['Research', svg('<path d="M4 5h7a2 2 0 0 1 2 2v13a2 2 0 0 0-2-2H4zM20 5h-7"/><path d="M20 5v13h-7"/>')],
  sources: ['Sources', svg('<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3A4 4 0 0 0 11 18.7l1-1"/>')],
};
---
<section class="p sec">
<h2 class="hd kr-title" style="margin:0 auto 24px;font-size:44px">Keep reading</h2>
<div class={`kr-grid${list.length > 2 ? ' kr-4' : ''}`}>
{list.map((a) => (
<a class="kr-card" href={a.href}>
<div class="kr-img"><div class="kr-ph">{a.img ? <img src={a.img} alt="" style={`object-position:${a.pos}`} loading="lazy" /> : <span>Soon</span>}</div></div>
<div class="kr-body">
<div class="kr-top"><span class="kr-kind">{a.kind}</span><span class="kr-pill">{a.pill}</span></div>
<h3 class="hd kr-h">{a.title}</h3>
<p class="kr-p">{a.intro}</p>
<div class="kr-bottom"><ul class="kr-chips">{a.chips.map((k) => <li><Fragment set:html={icons[k][1]} />{icons[k][0]}</li>)}</ul><span class="kr-arrow"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div>
</div>
</a>
))}
<a class={`kr-all${list.length > 2 ? ' kr-all-wide' : ''}`} href={isNotes ? '/notes/' : '/beauty/'}><div class="hand">{isNotes ? 'all my notes' : 'all my reviews'}</div><span class="kr-more">See them all</span></a>
</div>
</section>
<style is:global>
.s .kr-title{max-width:none;margin:0 0 24px !important;padding-left:28px}
.s .kr-grid{max-width:none !important;margin:0 !important;width:100%;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid #C9C9C9;border-left:1px solid #C9C9C9}
.s .kr-card{display:grid;grid-template-columns:150px minmax(0,1fr);gap:20px;align-items:stretch;color:inherit;text-decoration:none;background:#fff;padding:22px 28px;border-right:1px solid #C9C9C9;border-bottom:1px solid #C9C9C9;transition:background .35s}
.s .kr-card:hover{background:#F7F7F7}
.s .kr-img{position:relative;overflow:hidden;background:#E9E6E1;min-height:150px}
.s .kr-ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#8A8A8A;font-family:'Inter Tight',sans-serif;font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase}
.s .kr-ph img{display:block;width:100%;height:100%;object-fit:cover;max-height:none;transition:transform 1.1s cubic-bezier(.2,.7,.2,1)}
.s .kr-card:hover .kr-ph img{transform:scale(1.06)}
.s .kr-body{display:flex;flex-direction:column;min-width:0}
.s .kr-top{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.s .kr-kind{font-family:'Inter Tight',sans-serif;font-size:11px;color:#8A8A8A;letter-spacing:.04em}
.s .kr-pill{border:1px solid #8A8A8A;border-radius:999px;padding:2px 9px;font-family:'Inter Tight',sans-serif;font-weight:600;font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:#4A4A4A;white-space:nowrap;transition:background .3s,border-color .3s,color .3s}
.s .kr-card:hover .kr-pill{background:#F2C6D3;border-color:#F2C6D3;color:#8F2E47}
.s .kr-h{margin:0;font-size:22px;line-height:1.05;color:#3A3A3A;transition:color .3s}
.s .kr-card:hover .kr-h{color:#B0475E}
.s .kr-p{margin:7px 0 0;font-family:'Newsreader',serif;font-size:15.5px;line-height:1.42;color:#4A4A4A;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.s .kr-bottom{margin-top:auto;padding-top:10px;display:flex;justify-content:space-between;align-items:center;gap:8px}
.s .kr-chips{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:4px 10px}
.s .kr-chips li{display:inline-flex;align-items:center;gap:5px;font-family:'Inter Tight',sans-serif;font-size:11px;font-weight:600;color:#6A6A6A}
.s .kr-chips svg{width:13px;height:13px;color:#B0475E;flex:none}
.s .kr-arrow{display:inline-flex;flex:none;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;border:1px solid #B0475E;color:#B0475E;transition:background .3s,color .3s,transform .3s}
.s .kr-card:hover .kr-arrow{background:#B0475E;color:#fff;transform:translateX(3px)}
.s .kr-all{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;background:#F2C6D3;color:#8F2E47;text-decoration:none;padding:22px 28px;border-right:1px solid #C9C9C9;border-bottom:1px solid #C9C9C9}
.s .kr-all .hand{font-size:32px;line-height:1;color:#8F2E47}
.s .kr-more{font-family:'Inter Tight',sans-serif;font-weight:700;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#8F2E47}
.s .kr-all:hover .kr-more{text-decoration:underline}
.s .kr-all-wide{display:none}
@media (min-width:1500px){.s .kr-grid.kr-4{grid-template-columns:repeat(4,minmax(0,1fr))}.s .kr-all-wide{display:flex}}
@media (max-width:1100px){.s .kr-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.s .kr-all-wide{display:flex}.s .kr-all:not(.kr-all-wide){grid-column:1/-1;flex-direction:row;gap:22px;min-height:96px}}
@media (max-width:760px){.s .kr-grid{grid-template-columns:1fr}.s .kr-all,.s .kr-all-wide{grid-column:auto;min-height:110px}}
</style>
