---
import { articles } from '../data/articles.mjs';
const { items = [], compact = false } = Astro.props;
const list = items.map((h) => ({ href: h, ...articles[h] })).filter((a) => a.title);
const svg = (p) => `<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;
const icons = {
  facts: ['Product facts', svg('<rect x="5" y="4" width="14" height="16" rx="2"/><path d="M9 9h6M9 13h6M9 17h3"/>')],
  ing: ['Ingredients', svg('<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-9V3"/><path d="M8 15h8"/>')],
  skin: ['Skin concerns', svg('<path d="M12 3c3 4 6 7 6 10.5A6 6 0 0 1 6 13.5C6 10 9 7 12 3z"/>')],
  sun: ['SPF', svg('<circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/>')],
  eye: ['Eye patches', svg('<path d="M2 12s4-6 10-6 10 6 10 6-4 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="2.5"/>')],
  face: ['Face products', svg('<circle cx="12" cy="12" r="9"/><path d="M8.5 14.5c1 1.2 2.2 1.8 3.5 1.8s2.5-.6 3.5-1.8M9 10h.01M15 10h.01"/>')],
  research: ['Research', svg('<path d="M4 5h7a2 2 0 0 1 2 2v13a2 2 0 0 0-2-2H4zM20 5h-7"/><path d="M20 5v13h-7"/>')],
  sources: ['Sources', svg('<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3A4 4 0 0 0 11 18.7l1-1"/>')],
};
---
<section id="grid" class={`p kg-a kg-3${compact ? ' kg-s' : ''}`} style="padding-top:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr))">
{list.map((a, i) => (
<a class="kc" href={a.href} data-t={a.cat}><div class="kc-top"><span class="kc-kind"><b>{String(i + 1).padStart(2, '0')}</b>{a.kind}</span><span class="kc-pill">{a.pill}</span></div><div class="kc-img"><div class="kc-ph">{a.img ? <img src={a.img} alt="" style={`object-position:${a.pos || '50% 50%'}`} loading="lazy" /> : <span>Photo coming soon</span>}</div></div><div class="kc-body"><h3 class="hd kc-h">{a.title}</h3><p class="kc-p">{a.intro}</p><ul class="kc-chips">{a.chips.map((k) => <li><Fragment set:html={icons[k][1]} />{icons[k][0]}</li>)}</ul><div class="kc-foot"><span class="kc-more">{a.kind === 'Recipe' ? 'See the recipe' : a.kind === 'Note' ? 'Read the note' : a.kind === 'Routine' ? 'Read the routine' : 'Read the review'}</span><span class="kc-arrow"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div></div></a>
))}
{compact && <div class="kc kc-soon kc-wide"><span class="hand">more notes soon</span><p>New guides and small habits are on their way.</p></div>}
</section>
