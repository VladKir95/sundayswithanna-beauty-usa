  kiwi: '<circle cx="32" cy="32" r="22"/><circle cx="32" cy="32" r="16"/><ellipse cx="32" cy="32" rx="5" ry="6"/><path d="M32 20v-4M32 48v-4M20 32h-4M48 32h-4M23.5 23.5l-2.8-2.8M43.3 43.3l-2.8-2.8M40.5 23.5l2.8-2.8M20.7 43.3l2.8-2.8"/>',
  spinach: '<path d="M32 56C14 50 10 28 32 8c22 20 18 42 0 48Z"/><path d="M32 12v46"/><path d="M32 26l-9-7M32 36l-12-9M32 46l-9-7M32 26l9-7M32 36l12-9M32 46l9-7"/>',
  pineapple: '<ellipse cx="32" cy="41" rx="13" ry="17"/><path d="M22 33l20 20M20 43l14 14M42 33 22 53M44 43 30 57M26 26l20 22"/><path d="M32 24c-4-6-5-11-3-16 3 4 4 8 3 12 1-5 4-9 9-10-2 6-4 10-9 14Z"/>',
