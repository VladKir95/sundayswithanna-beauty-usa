};
---
<svg class="ing-line" viewBox="0 0 64 64" fill="none" stroke="#B0475E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[name]}></svg>
<style is:global>
.s .ing-line{display:block;width:100%;height:100%}
</style>
